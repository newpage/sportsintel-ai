APP_NAME=SportsIntel AI API
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

WEB_HOST=127.0.0.1
WEB_PORT=3300
API_HOST=127.0.0.1
API_PORT=8300

PUBLIC_URL=https://sportsintel.discovera.ai
NEXT_PUBLIC_API_URL=https://sportsintel.discovera.ai/api
CORS_ORIGINS=https://sportsintel.discovera.ai

DB_HOST=postgres
DB_PORT=5432
DB_NAME=sportsintel
DB_USER=sportsintel
DB_PASSWORD=change-this-password

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=1440

SPORTS_DATA_PROVIDER=demo
OLLAMA_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3:14b

ADMIN_BOOTSTRAP_EMAIL=admin@discovera.ai
ACCESS_TOKEN_COOKIE=sportsintel_access_token
ACCESS_TOKEN_SECURE=false
